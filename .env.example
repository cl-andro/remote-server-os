# ---------------------------------------------------------------------------
# Remote GPU Servers — Environment Configuration (TEMPLATE)
# Copy to .env and fill in your own values:  cp .env.example .env
# NEVER commit .env
# ---------------------------------------------------------------------------

# 1. Kaggle API tokens (one per account, KGAT_...)
#    Get yours at https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_ACCOUNT_1_TOKEN=KGAT_your_token_here
KAGGLE_ACCOUNT_2_TOKEN=
KAGGLE_ACCOUNT_3_TOKEN=
KAGGLE_ACCOUNT_4_TOKEN=

# 2. Cloudflare Tunnel token
#    Create a named tunnel at https://one.dash.cloudflare.com -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# 3. Public URL of your tunnel
CLUSTER_URL=https://your-subdomain.example.com

# 4. Web UI & API authentication (HTTP Basic Auth)
#    These are embedded into the generated notebook, so use strong values.
CLUSTER_AUTH_USER=change-me
CLUSTER_AUTH_PASS=change-me-to-a-strong-password

# 5. Max seconds to wait for the server to come online
CLUSTER_TIMEOUT=600
